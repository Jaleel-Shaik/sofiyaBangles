# ==============================================================================
# SOFIYA BANGLES - ROOT ENVIRONMENT / PORT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env at project root to customize port mappings & URLs.

# --- CUSTOM NON-COLLIDING HOST PORTS ---
# (Different from standard 3000 / 5000 to prevent port collisions on your machine)
BACKEND_PORT=5050
WEB_PORT=3050

# --- PUBLIC URLS ---
# Frontend API endpoint to reach Backend
NEXT_PUBLIC_API_URL=http://localhost:5050/api
