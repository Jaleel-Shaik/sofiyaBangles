# ==============================================================================
# SOFIYA BANGLES - NGINX PRODUCTION REVERSE PROXY CONFIGURATION
# Platform: Oracle Cloud Infrastructure (OCI) Always Free Ubuntu/Debian VM
# Location on server: /etc/nginx/sites-available/sofiya-bangles
# ==============================================================================

# ── 1. Backend REST API (api.yourdomain.com) ───────────────────────────────────
server {
    server_name api.yourdomain.com;

    # Listening on HTTP (Certbot will automatically add SSL / port 443 redirect)
    listen 80;
    listen [::]:80;

    # Maximum file upload size (matches Cloudinary / image upload limits)
    client_max_body_size 25M;

    # Logging
    access_log /var/log/nginx/sofiya_api_access.log;
    error_log /var/log/nginx/sofiya_api_error.log;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # Healthcheck bypass
    location = /health {
        proxy_pass http://127.0.0.1:5000/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # API Routing
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        # WebSocket & connection upgrade support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Forward real client IPs to Node.js backend
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Proxy timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffer configurations
        proxy_buffering on;
        proxy_buffers 8 16k;
        proxy_buffer_size 16k;
    }
}

# ── 2. (Optional) Next.js Admin Web Portal (admin.yourdomain.com) ─────────────
# Uncomment this block if you run the Next.js Web Portal on the same Oracle VM
# running on port 3000 (via PM2: `pm2 start npm --name "sofiya-web" -- start`)
