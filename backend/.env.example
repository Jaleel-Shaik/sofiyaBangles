# ==============================================================================
# SOFIYA BANGLES - BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and fill in the values for local or containerized execution.

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=production

# CORS allowed origins (comma-separated). Leave empty in dev to allow all.
CORS_ORIGINS=http://localhost:3050,http://localhost:3000,http://127.0.0.1:3050

# --- DATABASE (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# --- AUTH & JWT SECURITY ---
JWT_SECRET=replace_with_a_secure_random_64_char_secret_key_for_sofiya_bangles
JWT_EXPIRES_IN=7d

# --- 2FA & TOTP ENCRYPTION ---
TOTP_ENCRYPTION_KEY=32_byte_secret_key_for_encrypting_totp_secrets
TOTP_QR_CODE_EXPIRY_MS=600000

# --- FIREBASE ADMIN CONFIGURATION ---
# Option 1: File mount path (default for local & docker-compose)
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json
FIREBASE_STORAGE_BUCKET=sofiya-bangles.appspot.com

# Option 2: Inline JSON or Base64 (ideal for cloud container platforms like Cloud Run / Render)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50Iiw...

# --- CLOUDINARY MEDIA STORAGE ---
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# --- NOTIFICATIONS & WHATSAPP ---
WHATSAPP_NUMBER=919876543210

# --- TWILIO SMS (OPTIONAL) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- SESSION & AUDIT LIFECYCLE ---
SESSION_CLEANUP_INTERVAL_MS=3600000
LOGIN_CHALLENGE_TTL_MS=300000
SESSION_EXPIRY_GRACE_MS=0
AUDIT_RETENTION_DAYS=90
SECURITY_EVENT_RETENTION_DAYS=365
MAX_ACTIVE_SESSIONS=5
